PG_PASSWORD=change_me_strong_password
KOPIA_PASSWORD=change_me_kopia_password
AI_ENABLED=false
PIM_AI_DEFAULT_MODEL=pim-default
# Create PIM_LITELLM_VIRTUAL_KEY with LITELLM_MASTER_KEY.
# Do not give LITELLM_MASTER_KEY to PIM except for one-time local temporary testing.
PIM_LITELLM_VIRTUAL_KEY=sk-change-me-virtual
LITELLM_MASTER_KEY=sk-change-me-master
LITELLM_SALT_KEY=change-me-long-random-salt
LITELLM_UPSTREAM_MODEL=openai/gpt-4.1-mini
LITELLM_UPSTREAM_API_KEY=sk-change-me-upstream
LITELLM_UPSTREAM_API_BASE=https://api.openai.com/v1
# /metrics 与运维只读接口的访问密钥（可逗号分隔多个）；同时写入 deploy/prometheus/ops_token
PIM_OPS_KEY=change_me_ops_key
# 可选：Tika 文本抽取服务地址（供 read_file_text 抽取 pdf 等二进制文档）。
# 留空则这些类型返回明确的「不支持」错误，文本/docx/pptx 不受影响。
# TIKA_BASE_URL=http://127.0.0.1:9998
# 可选：Loki 日志聚合地址（配合 docker compose --profile observability 使用）
LOKI_URL=http://loki:3100
