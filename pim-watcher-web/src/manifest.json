{
  "manifest_version": 3,
  "name": "PIM Browser Watcher",
  "version": "1.0.0",
  "description": "Tracks active browser tab for PIM usage analytics",
  "icons": {
    "128": "logo-128.png"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "notifications",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:15601/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "128": "logo-128.png"
    }
  }
}
