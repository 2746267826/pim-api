{
  "stryker-config": {
    "test-projects": ["tests/Pim.UnitTests/Pim.UnitTests.csproj"],
    "mutate": [
      "**/MobileUsageAggregationService.cs",
      "**/PcTrackerService.cs",
      "**/MobileLocationAggregationService.cs",
      "**/MobileFrequentPlaceService.cs"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "reporters": ["html", "progress", "json"],
    "concurrency": 2,
    "coverage-analysis": "perTest",
    "ignore-mutations": [],
    "ignore-methods": []
  }
}
