    <Compile Include="..\..\src\client-windows\Pim.Client.App\Services\BootstrapLog.cs" Link="ClientWindows\BootstrapLog.cs" />
    <Compile Include="..\..\src\client-windows\Pim.Client.App\Services\Logger.cs" Link="ClientWindows\Logger.cs" />
