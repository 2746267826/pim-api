{
  "stryker-config": {
    "test-projects": ["tests/Pim.UnitTests/Pim.UnitTests.csproj"],
    "mutate": ["src/**/*.cs", "!**/Migrations/**", "!**/obj/**", "!**/bin/**"],
    "mutation-level": "Basic",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "reporters": ["html", "progress", "json"],
    "concurrency": 4,
    "coverage-analysis": "perTest"
  }
}
