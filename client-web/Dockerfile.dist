# 只含静态文件的产物镜像（REQ-1 契约）。
#
# 内容 = client-web/dist 全量，镜像根目录就是 dist 根：pim-api 构建时用
# `COPY --from=<本镜像> / /app/wwwroot/` 直接取用。
#
# 为什么是 scratch：契约要求"只含静态文件的极简镜像"。scratch 没有 shell，
# 读取镜像内文件用 `docker create` + `docker cp`（见 pim-api 的 resolve-web-dist.sh）。
#
# 该镜像里的 web-version.json 是"pim-web 这一侧"的版本真相来源（REQ-2）。
FROM scratch

ARG PIM_WEB_VERSION=unknown
ARG PIM_WEB_SHA=unknown

LABEL org.opencontainers.image.title="pim-web-dist" \
      org.opencontainers.image.version="$PIM_WEB_VERSION" \
      org.opencontainers.image.revision="$PIM_WEB_SHA"

COPY dist/ /
