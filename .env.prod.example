# PIM Docker 生产部署环境变量模板
# 使用: cp .env.prod.example .env.prod && 填写真实值
# 部署: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# --- 镜像与端口 ---
PIM_IMAGE_TAG=latest
PIM_HTTP_PORT=5858            # 宿主机 HTTP 端口（监听 0.0.0.0 对外，反代 https://域名:port 均可达）

# --- 数据库 ---
PG_CONNECTION=Host=CHANGE_ME;Database=pim;Username=pim;Password=CHANGE_ME

# --- Ops 只读 API ---
PIM_OPS_KEY=CHANGE_ME # ops 只读密钥，逗号分隔多值轮换
PIM_OPS_RO_CONNECTION=Host=CHANGE_ME;Database=pim;Username=pim_ro;Password=CHANGE_ME;CommandTimeout=10

# --- 日志保留与轮转 ---
# 日志保留总文件份数（默认 2；注意 Serilog 按文件分卷数而非自然日淘汰，若需保留更长时间的分卷可适当调大，例如 10）
PIM_LOG_RETAINED_FILES=2
# 单个日志文件大小上限（字节，默认 1073741824 = 1 GiB；设为 0、null、none 或 unlimited 表示不限大小）
# PIM_LOG_FILE_SIZE_LIMIT_BYTES=1073741824
# 达到单文件大小上限时是否滚动为新分卷（默认 true；设为 false 则达上限后停写）
# PIM_LOG_ROLL_ON_FILE_SIZE_LIMIT=true

# --- 应用配置 ---
KOPIA_PASSWORD=CHANGE_ME
AI_ENABLED=false
AI_BASE_URL=http://CHANGE_ME:4000
AI_API_KEY=CHANGE_ME
AI_DEFAULT_MODEL=pim-default

# --- OneDrive（文件模块 v2 唯一文件来源）---
# 租户：个人版保持 consumers；组织账号填租户 ID 或域名。
FILES_ONEDRIVE_TENANT=consumers
# 敏感路径规则（逗号分隔的 glob，段边界匹配、大小写不敏感）。
# 命中后禁止产生外链 / 预览 / 文本读写 / read_file_text / 搜索结果。
# 默认即下述两条，如需额外保护可在此追加。
# FILES_SENSITIVE_PATH_PATTERNS=/Secrets/*,/Passwords/*

# --- 可选：Tika 文本抽取 ---
# 供 read_file_text 抽取 pdf 等二进制文档；留空则这些类型明确返回「不支持」。
# 文本 / docx / pptx 由内置抽取器处理，不依赖 Tika。
# TIKA_BASE_URL=http://CHANGE_ME:9998
