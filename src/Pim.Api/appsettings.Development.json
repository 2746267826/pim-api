{
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=pim;Username=pim;Password=CHANGE_ME"
  },
  "DataProtection": {
    "KeysPath": "./data/keys/data-protection"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "CHANGE_ME",
    "SecretKey": "CHANGE_ME"
  },
  "Kopia": {
    "RepositoryPath": "./data/kopia-repo",
    "Password": "CHANGE_ME"
  },
  "Tika": {
    "BaseUrl": "http://localhost:9998"
  },
  "Ai": {
    "Enabled": false,
    "Provider": "litellm",
    "BaseUrl": "http://127.0.0.1:4000",
    "ApiKey": "",
    "DefaultModel": "pim-default",
    "TimeoutSeconds": 30,
    "MaxOutputTokensPerRequest": 1000,
    "MaxAttemptsPerRequest": 2,
    "SaveFullPrompts": true,
    "SaveFullResponses": true
  },
  "Nextcloud": {
    "PublicBaseUrl": "http://localhost:8080",
    "InternalBaseUrl": "http://localhost:8080"
  },
  "OnlyOffice": {
    "PublicUrl": "http://localhost:8082",
    "JwtSecret": ""
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "Url": "http://localhost:6333",
    "Collection": "pim_file_chunks"
  },
  "Embedding": {
    "Provider": "hashing",
    "Dimensions": 384
  },
  "Files": {
    "MaxInlineTextBytes": 1048576,
    "AiDisabledPathPatterns": ["/Secrets/*", "/Passwords/*"]
  }
}
