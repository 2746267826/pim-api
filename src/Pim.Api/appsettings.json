{
  "MCP": {
    "Enabled": true,
    "Path": "/mcp"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.ChangeTracking": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=pim;Username=pim;Password=CHANGE_ME"
  },
  "Jwt": {
    "PrivateKeyPath": "/data/keys/jwt_private.pem"
  },
  "DataProtection": {
    "KeysPath": "/data/keys/data-protection"
  },
  "Kopia": {
    "RepositoryPath": "/data/kopia-repo",
    "Password": "CHANGE_ME"
  },
  "Tika": {
    "BaseUrl": ""
  },
  "Tiles": {
    "UpstreamBaseUrl": "https://tile.openstreetmap.org",
    "CacheDirectory": "/data/pim/cache/tiles",
    "CacheTtl": "7.00:00:00",
    "RequestTimeout": "00:00:10"
  },
  "Files": {
    "OneDrive": {
      "Tenant": "consumers"
    },
    "SensitivePathPatterns": ["/Secrets/*", "/Passwords/*"],
    "MaxInlineTextBytes": 1048576
  },
  "Hangfire": {
    "Username": "",
    "Password": "",
    "DashboardAllowedRoles": ["admin"]
  },
  "Notifications": {
    "Dispatcher": {
      "Enabled": true,
      "PollIntervalSeconds": 5,
      "NoteScanIntervalSeconds": 60,
      "ReminderScanIntervalSeconds": 15,
      "FanoutBatchSize": 50,
      "DeliveryBatchSize": 20,
      "MaxAttempts": 5,
      "BaseDelaySeconds": 30,
      "MaxDelaySeconds": 3600,
      "LockSeconds": 120,
      "ProviderTimeoutSeconds": 15,
      "LeaseSafetyMarginSeconds": 60
    },
    "WebPush": {
      "PublicKey": "",
      "PrivateKey": "",
      "Subject": "mailto:admin@example.invalid",
      "TtlSeconds": 300,
      "TimeoutSeconds": 10
    }
  },
  "Invariants": {
    "MinInputDensityPerMinute": 1.0,
    "LongEventThresholdMinutes": 30.0,
    "UndeclaredOfflineGapMinutes": 30.0,
    "MaxUploadLagP99Minutes": 30.0,
    "MobileSummaryLagHours": 4.0,
    "AssessmentWindowHours": 168.0,
    "CoverageWindowHours": 24.0,
    "MaxDailyActiveHours": 24.0,
    "AwakeWindowHours": 16.0,
    "AwakeWindowWarningRatio": 0.9,
    "CoverageRedRatio": 0.95,
    "CoverageYellowRatio": 0.99,
    "MaxSampleCount": 10,
    "ClockSkewToleranceMinutes": 5.0,
    "TimelineGapThresholdMinutes": 15.0,
    "MaxScanRows": 20000,
    "InspectionTimeoutSeconds": 60,
    "Tolerance": 0.05
  }
}
