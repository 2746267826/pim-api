<Project>
  <PropertyGroup>
    <!-- Base version: stable release tag (e.g. v1.0.0). Default = 0.0.0 for untagged builds -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.0.0</VersionPrefix>
    <!-- Assembly version must be 4-part numeric, used for runtime binding -->
    <Version>$(VersionPrefix).0</Version>
    <!-- Git hash injected by CI: -p:GitHash=xxxxxxx -->
    <GitHash Condition="'$(GitHash)' == ''">0000000</GitHash>
    <!-- Full display string: 1.0.0(abc1234) -->
    <InformationalVersion>$(VersionPrefix)($(GitHash))</InformationalVersion>
    <!-- Set FileVersion too so Windows shows it in properties / task manager -->
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>
</Project>
